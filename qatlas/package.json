{
  "name": "qatlas",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test automation for SauceDemo using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2"
  }
}
